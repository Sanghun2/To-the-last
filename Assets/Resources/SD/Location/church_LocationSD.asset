  storyDescription: "\uB300\uC7AC\uC559\uC774 \uC2DC\uC791\uB418\uC5C8\uC744 \uB54C,
    \uC774 \uC131\uB2F9\uC740 \uB9C8\uC9C0\uB9C9 \uAD6C\uC6D0\uC744 \uBC14\uB77C\uB294
    \uC774\uB4E4\uC758 \uAC70\uB300\uD55C \uD53C\uB09C\uCC98\uC600\uC2B5\uB2C8\uB2E4.
    \uC0AC\uB78C\uB4E4\uC740 \uB450\uAEBC\uC6B4 \uC131\uBB38\uC744 \uAC78\uC5B4 \uC7A0\uADF8\uACE0
    \uC2E0\uC5D0\uAC8C \uAE30\uB3C4\uD558\uBA70 \uAE30\uC801\uC744 \uAE30\uB2E4\uB838\uC9C0\uB9CC,
    \uAD76\uC8FC\uB9B0 \uC880\uBE44\uB4E4\uC740 \uCC9C\uC7A5\uC758 \uC2A4\uD14C\uC778\uB4DC\uAE00\uB77C\uC2A4\uB97C
    \uAE68\uACE0 \uBB34\uC790\uBE44\uD558\uAC8C \uC3DF\uC544\uC838 \uB4E4\uC5B4\uC654\uC2B5\uB2C8\uB2E4.
    \uBE44\uBA85 \uC18C\uB9AC\uB294 \uCC2C\uC1A1\uAC00 \uB300\uC2E0 \uC131\uB2F9\uC744
    \uAC00\uB4DD \uCC44\uC6E0\uACE0, \uC2E0\uC131\uD588\uB358 \uC81C\uB2E8\uC740
    \uC0DD\uC874\uC744 \uC704\uD55C \uB9C8\uC9C0\uB9C9 \uC0AC\uD22C\uC758 \uD604\uC7A5\uC73C\uB85C
    \uBCC0\uD588\uC2B5\uB2C8\uB2E4. \uC774\uC81C\uB294 \uBD80\uC11C\uC9C4 \uC2ED\uC790\uAC00
    \uC544\uB798 \uD769\uC5B4\uC9C4 \uC2DC\uC2E0\uB4E4\uB9CC\uC774 \uC778\uAC04\uC758
    \uBBFF\uC74C\uC870\uCC28 \uAD6C\uC6D0\uD558\uC9C0 \uBABB\uD55C \uADF8\uB0A0\uC758
    \uCC38\uD639\uD55C \uBE44\uADF9\uC744 \uB9D0\uD574\uC8FC\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
