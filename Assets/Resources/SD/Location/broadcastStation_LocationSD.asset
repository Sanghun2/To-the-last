  displayName: "\uBC29\uC1A1\uAD6D"
  descripiton: "\uBC29\uC1A1\uAD6D"
  iconImage: {fileID: 21300000, guid: 777fa81dc842d45e48bf73fa9a6055fe, type: 3}
  mainImage: {fileID: 21300000, guid: 9766325cb779a2a4d86fc8c2029eccbe, type: 3}
  storyDescription: "Gemini said\r\n\uC138\uC0C1\uC774 \uBB34\uB108\uC9C0\uB358 \uC21C\uAC04,
    \uC774 \uBC29\uC1A1\uAD6D\uC740 \uC778\uB958\uAC00 \uC18C\uC2DD\uC744 \uB4E4\uC744
    \uC218 \uC788\uB294 \uB9C8\uC9C0\uB9C9 \uC5F0\uACB0 \uACE0\uB9AC\uC600\uC2B5\uB2C8\uB2E4.
    \uC544\uB098\uC6B4\uC11C\uC640 \uAE30\uC220\uC9C4\uB4E4\uC740 \uBAB0\uB824\uC624\uB294
    \uC880\uBE44\uB4E4\uC744 \uD53C\uD574 \uC2A4\uD29C\uB514\uC624 \uBB38\uC744 \uAC78\uC5B4
    \uC7A0\uADF8\uACE0, \uBAA9\uC774 \uC274 \uB54C\uAE4C\uC9C0 \uB300\uD53C \uC694\uB839\uACFC
    \uAD6C\uC870 \uC2E0\uD638\uB97C \uC1A1\uCD9C\uD588\uC2B5\uB2C8\uB2E4. \uD558\uC9C0\uB9CC
    \uC804\uB825\uC774 \uB04A\uAE30\uACE0 \uBC29\uC5B4\uC120\uC774 \uB6AB\uB9AC\uBA74\uC11C,
    \uB9C8\uC9C0\uB9C9 \"\uCE58\uC775-\" \uD558\uB294 \uB178\uC774\uC988\uC640 \uD568\uAED8
    \uC778\uB958\uC758 \uBAA9\uC18C\uB9AC\uB3C4 \uC601\uC6D0\uD788 \uC7A0\uACA8\uBC84\uB9AC\uACE0
    \uB9D0\uC558\uC8E0. \uC774\uC81C\uB294 \uC8FC\uC778\uC744 \uC783\uC740 \uB9C8\uC774\uD06C\uC640
    \uCF1C\uC9C0\uC9C0 \uC54A\uB294 \uBAA8\uB2C8\uD130\uB9CC\uC774 \uCC28\uAC00\uC6B4
    \uACF5\uAE30 \uC18D\uC5D0\uC11C \uADF8\uB0A0\uC758 \uAE34\uBC15\uD588\uB358 \uB9C8\uC9C0\uB9C9
    \uBC29\uC1A1\uC744 \uAE30\uC5B5\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
