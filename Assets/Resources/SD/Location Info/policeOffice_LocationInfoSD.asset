  id: policeOffice
  displayText: "\uACBD\uCC30\uC11C"
  descripiton: "\uCE58\uC548\uC744 \uC720\uC9C0\uD558\uB358 \uACBD\uCC30\uC11C. \uC704\uAE30\uC758
    \uC0C1\uD669\uC5D0\uC11C \uBD84\uD22C\uD588\uB358 \uD754\uC801\uC774 \uBCF4\uC778\uB2E4."
  categoryList: []
  image: {fileID: 21300000, guid: 65b2a9b4448cb924baec121c34b13279, type: 3}
  storyDescription: "\uC774 \uACBD\uCC30\uC11C\uB294 \uC7AC\uB09C \uCD08\uAE30, \uB3C4\uC2DC\uC758
    \uB9C8\uC9C0\uB9C9 \uC9C8\uC11C\uB97C \uC720\uC9C0\uD558\uB824\uB358 \uC911\uC2EC\uC9C0\uC600\uB2E4.\n\uACBD\uCC30\uACFC
    \uC77C\uBD80 \uC2DC\uBBFC\uB4E4\uC774 \uBAA8\uC5EC \uC784\uC2DC \uBCF4\uD638\uC18C\uC774\uC790
    \uC9C0\uD718 \uAC70\uC810\uC73C\uB85C \uC0AC\uC6A9\uD588\uB2E4.\n\uD558\uC9C0\uB9CC
    \uAD6C\uC870 \uC694\uCCAD\uC774 \uB04A\uAE30\uACE0 \uC678\uBD80\uAC00 \uBB34\uB108\uC9C0\uBA74\uC11C
    \uB0B4\uBD80\uC5D0\uC11C\uB3C4 \uAC08\uB4F1\uC774 \uC2DC\uC791\uB410\uB2E4.\n\uBB34\uAE30\uACE0\uB97C
    \uB458\uB7EC\uC2FC \uCDA9\uB3CC\uACFC \uAC10\uC5FC \uD655\uC0B0\uC73C\uB85C \uACB0\uAD6D
    \uB0B4\uBD80 \uBC29\uC5B4\uC120\uC774 \uBD95\uAD34\uB410\uB2E4.\n\uC9C0\uAE08\uC740
    \uD3D0\uD5C8\uB9CC \uB0A8\uC558\uC9C0\uB9CC, \uC548\uCABD\uC5D0\uB294 \uC5EC\uC804\uD788
    \uBD09\uC778\uB418\uC9C0 \uBABB\uD55C \uAE30\uB85D\uACFC \uBB34\uAE30\uAC00 \uB0A8\uC544
    \uC788\uB2E4\uB294 \uC18C\uBB38\uC774 \uB3C8\uB2E4."
  iconImage: {fileID: 21300000, guid: 11228b8f44fe04465a4c7ade8e51b20c, type: 3}
