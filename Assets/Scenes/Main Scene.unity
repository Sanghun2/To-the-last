    - target: {fileID: 6005038280624510519, guid: 2c7b9360d1de5e84f9ccb9d966cb7f73, type: 3}
      propertyPath: m_text
      value: "\uD55C\uB54C \uC544\uC774\uB4E4\uC758 \uC6C3\uC74C\uC18C\uB9AC\uB85C
        \uAC00\uB4DD\uD588\uB358 \uC774 \uB180\uC774\uACF5\uC6D0\uC740 \uB300\uC7AC\uC559\uC758
        \uB0A0, \uAC70\uB300\uD55C \uD568\uC815\uC73C\uB85C \uBCC0\uD588\uC2B5\uB2C8\uB2E4.
        \uD654\uB824\uD55C \uD68C\uC804\uBAA9\uB9C8\uC758 \uBD88\uBE5B\uC774 \uAEBC\uC9C0\uAE30\uB3C4
        \uC804\uC5D0 \uBAB0\uB824\uB4E0 \uC880\uBE44 \uB5BC\uB97C \uD53C\uD574 \uC0AC\uB78C\uB4E4\uC740
        \uB180\uC774\uAE30\uAD6C \uC704\uB85C \uAE30\uC5B4\uC62C\uB77C\uAC00\uBA70
        \uD544\uC0AC\uC801\uC73C\uB85C \uBC84\uD17C\uC8E0. \uD558\uC9C0\uB9CC \uBA48\uCDB0\uBC84\uB9B0
        \uAE30\uAD6C \uC704\uC5D0\uC11C \uB0B4\uB824\uC624\uC9C0 \uBABB\uD55C \uC774\uB4E4\uC740
        \uACB0\uAD6D \uAD76\uC8FC\uB9BC\uACFC \uACF5\uD3EC \uC18D\uC5D0 \uD558\uB098\uB458
        \uC4F0\uB7EC\uC838 \uAC14\uC2B5\uB2C8\uB2E4. \uC774\uC81C\uB294 \uB179\uC2A8
        \uB9D0\uB4E4\uACFC \uAE30\uAD34\uD558\uAC8C \uBA48\uCD98 \uAD00\uB78C\uCC28\uB9CC\uC774
        \uADF8\uB0A0\uC758 \uBE44\uBA85 \uC18C\uB9AC\uB97C \uC0BC\uD0A8 \uCC44, \uD669\uB7C9\uD55C
        \uBC14\uB78C\uC5D0 \uD754\uB4E4\uB9AC\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
